{
	"name": "thierrypigot/wp-cli-db-prefix",
	"description": "WP-CLI command that safely renames the WordPress table prefix: pre-flight checks, atomic table rename, automatic rollback, multisite support.",
	"type": "wp-cli-package",
	"keywords": [
		"wp-cli",
		"wordpress",
		"database",
		"prefix",
		"table_prefix",
		"security"
	],
	"homepage": "https://github.com/thierrypigot/wp-cli-db-prefix",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Thierry Pigot",
			"homepage": "https://www.wearewp.pro"
		}
	],
	"support": {
		"issues": "https://github.com/thierrypigot/wp-cli-db-prefix/issues"
	},
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"files": [
			"command.php"
		]
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-cli/wp-cli": "^2.11"
	},
	"scripts": {
		"test": [
			"@test:unit",
			"@test:integration"
		],
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration"
	},
	"config": {
		"platform": {
			"php": "7.4"
		}
	}
}
