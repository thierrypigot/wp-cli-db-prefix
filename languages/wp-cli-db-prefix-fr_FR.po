#. translators: %s: generated prefix.
#: src/class-wp-cli-db-prefix-command.php:108
msgid "Generated prefix: %s"
msgstr "Préfixe généré : %s"

#. translators: %s: command to run.
#: src/class-wp-cli-db-prefix-command.php:114
msgid "A new prefix is drawn on every run. To use this one, run: %s"
msgstr "Un nouveau préfixe est tiré à chaque lancement. Pour utiliser celui-ci, lancez : %s"

#: src/class-wp-cli-db-prefix-command.php:117
msgid "Dry run complete, nothing was changed."
msgstr "Simulation terminée, rien n’a été modifié."

#: src/class-wp-cli-db-prefix-command.php:122
msgid "Back up before continuing (or use --safe): wp db export, plus a copy of wp-config.php."
msgstr "Faites une sauvegarde avant de continuer (ou utilisez --safe) : wp db export, et une copie de wp-config.php."

#. translators: 1: site URL, 2: current prefix, 3: new prefix.
#: src/class-wp-cli-db-prefix-command.php:127
msgid "Rename the table prefix of %1$s from \"%2$s\" to \"%3$s\"?"
msgstr "Renommer le préfixe des tables de %1$s de « %2$s » en « %3$s » ?"

#. translators: %s: new prefix.
#: src/class-wp-cli-db-prefix-command.php:157
msgid "wp-config.php was not changed. The site stays in maintenance mode (503) until you: 1. update the prefix (\"%s\") where it is defined; 2. run wp maintenance-mode deactivate."
msgstr "wp-config.php n’a pas été modifié. Le site reste en mode maintenance (503) tant que vous n’avez pas : 1. mis à jour le préfixe (« %s ») là où il est défini ; 2. lancé wp maintenance-mode deactivate."

#. translators: 1: new prefix, 2: number of tables, 3: number of sites, 4: number of user meta keys.
#: src/class-wp-cli-db-prefix-command.php:163
msgid "Prefix renamed to \"%1$s\": %2$d tables, %3$d site(s), %4$d user meta keys. Object cache flushed."
msgstr "Préfixe renommé en « %1$s » : %2$d tables, %3$d site(s), %4$d clés de métadonnées de compte. Cache objet vidé."

#: src/class-wp-cli-db-prefix-command.php:211
msgid "Could not generate a free prefix. Pass one explicitly."
msgstr "Impossible de générer un préfixe libre. Indiquez-en un vous-même."

#. translators: %s: backup folder.
#: src/class-wp-cli-db-prefix-command.php:250
msgid "Backup folder %s is ambiguous: give a path without \"..\"."
msgstr "Le dossier de sauvegarde %s est ambigu : indiquez un chemin sans « .. »."

#. translators: %s: folder path.
#: src/class-wp-cli-db-prefix-command.php:260
msgid "Cannot write in %s. Use --backup-dir with a writable folder."
msgstr "Impossible d’écrire dans %s. Utilisez --backup-dir avec un dossier accessible en écriture."

#. translators: %s: folder path.
#: src/class-wp-cli-db-prefix-command.php:269
msgid "Could not create the backup folder %s. Use --backup-dir with a writable folder."
msgstr "Impossible de créer le dossier de sauvegarde %s. Utilisez --backup-dir avec un dossier accessible en écriture."

#. translators: 1: backup folder, 2: web root.
#: src/class-wp-cli-db-prefix-command.php:307
msgid "Backup folder %1$s is inside the web root (%2$s): the backup could be downloaded. Use --backup-dir with a folder outside it."
msgstr "Le dossier de sauvegarde %1$s se trouve dans la racine web (%2$s) : la sauvegarde pourrait être téléchargée. Utilisez --backup-dir avec un dossier situé en dehors."

#. translators: %s: path to the SQL file.
#: src/class-wp-cli-db-prefix-command.php:353
msgid "Backing up the database to %s..."
msgstr "Sauvegarde de la base de données dans %s…"

#. translators: %s: error output of the export.
#: src/class-wp-cli-db-prefix-command.php:372
msgid "Backup failed, nothing was changed: %s"
msgstr "La sauvegarde a échoué, rien n’a été modifié : %s"

#. translators: %s: path to the copy.
#: src/class-wp-cli-db-prefix-command.php:384
msgid "Could not copy wp-config.php to %s, nothing was changed."
msgstr "Impossible de copier wp-config.php dans %s, rien n’a été modifié."

#. translators: %s: size of the SQL file.
#: src/class-wp-cli-db-prefix-command.php:396
msgid "Backup done (%s)."
msgstr "Sauvegarde terminée (%s)."

#: src/class-wp-cli-db-prefix-command.php:443
msgid "To go back to the saved state:"
msgstr "Pour revenir à l’état sauvegardé :"

#: src/class-wp-cli-db-prefix-command.php:452
msgid "The backup holds your database credentials: delete it once the site has been checked."
msgstr "La sauvegarde contient les informations de connexion à votre base de données : supprimez-la une fois le site vérifié."

#: src/class-wp-cli-db-prefix-command.php:461
msgid "WordPress 6.2 or later is required."
msgstr "WordPress 6.2 ou une version plus récente est nécessaire."

#: src/class-wp-cli-db-prefix-command.php:465
msgid "CUSTOM_USER_TABLE or CUSTOM_USER_META_TABLE is defined: shared user tables are not supported."
msgstr "CUSTOM_USER_TABLE ou CUSTOM_USER_META_TABLE est défini : les tables de comptes partagées ne sont pas prises en charge."

#. translators: %s: rejected prefix.
#: src/class-wp-cli-db-prefix-command.php:481
msgid "Prefix \"%s\" rejected: use lowercase letters, digits and underscores, start with a letter and end with an underscore."
msgstr "Préfixe « %s » refusé : utilisez des lettres minuscules, des chiffres et des tirets bas, commencez par une lettre et terminez par un tiret bas."

#: src/class-wp-cli-db-prefix-command.php:485
msgid "The new prefix is the same as the current one."
msgstr "Le nouveau préfixe est identique au préfixe actuel."

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:516
msgid "Could not list tables: %s"
msgstr "Impossible de lister les tables : %s"

#. translators: %s: table name.
#: src/class-wp-cli-db-prefix-command.php:541
msgid "Table %s not found: the current prefix does not match the database."
msgstr "Table %s introuvable : le préfixe actuel ne correspond pas à la base de données."

#. translators: 1: table name, 2: table type.
#: src/class-wp-cli-db-prefix-command.php:575
msgid "%1$s is a view (%2$s): its definition would still reference the old names. Not supported."
msgstr "%1$s est une vue (%2$s) : sa définition ferait encore référence aux anciens noms. Non pris en charge."

#. translators: 1: maximum length, 2: table name.
#: src/class-wp-cli-db-prefix-command.php:582
msgid "Name too long after renaming (%1$d characters maximum): %2$s. Choose a shorter prefix."
msgstr "Nom trop long après renommage (%1$d caractères maximum) : %2$s. Choisissez un préfixe plus court."

#. translators: %s: table name.
#: src/class-wp-cli-db-prefix-command.php:597
msgid "Table %s already exists."
msgstr "La table %s existe déjà."

#. translators: 1: table name, 2: site ID.
#: src/class-wp-cli-db-prefix-command.php:611
msgid "Table %1$s of site %2$d not found."
msgstr "Table %1$s du site %2$d introuvable."

#. translators: 1: option name, 2: table name.
#: src/class-wp-cli-db-prefix-command.php:618
msgid "Option %1$s not found in %2$s."
msgstr "Option %1$s introuvable dans %2$s."

#. translators: 1: option name, 2: table name.
#: src/class-wp-cli-db-prefix-command.php:625
msgid "Option %1$s already exists in %2$s (left over from a previous attempt?)."
msgstr "L’option %1$s existe déjà dans %2$s (reste d’une tentative précédente ?)."

#. translators: 1: number of user meta keys, 2: new prefix.
#: src/class-wp-cli-db-prefix-command.php:638
msgid "%1$d user meta key already starts with \"%2$s\". Choose another prefix."
msgid_plural "%1$d user meta keys already start with \"%2$s\". Choose another prefix."
msgstr[0] "%1$d clé de métadonnées de compte commence déjà par « %2$s ». Choisissez un autre préfixe."
msgstr[1] "%1$d clés de métadonnées de compte commencent déjà par « %2$s ». Choisissez un autre préfixe."

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:682
msgid "Could not list the network sites: %s"
msgstr "Impossible de lister les sites du réseau : %s"

#. translators: 1: trigger name, 2: table name.
#: src/class-wp-cli-db-prefix-command.php:732
msgid "Trigger %1$s is attached to %2$s: not supported."
msgstr "Le déclencheur %1$s porte sur %2$s : non pris en charge."

#: src/class-wp-cli-db-prefix-command.php:749
msgid "wp-config.php not found or not readable."
msgstr "wp-config.php introuvable ou illisible."

#. translators: %s: path to wp-config.php.
#: src/class-wp-cli-db-prefix-command.php:754
msgid "%s is not writable. Fix the permissions, or use --skip-config and edit it by hand."
msgstr "%s n’est pas accessible en écriture. Corrigez les droits, ou utilisez --skip-config et modifiez-le à la main."

#. translators: 1: number of lines found, 2: path to wp-config.php.
#: src/class-wp-cli-db-prefix-command.php:763
msgid "%1$d \"$table_prefix = '...';\" lines found in %2$s (exactly one expected). Use --skip-config and change the prefix by hand."
msgstr "%1$d lignes « $table_prefix = '...'; » trouvées dans %2$s (une seule attendue). Utilisez --skip-config et modifiez le préfixe à la main."

#. translators: 1: path to wp-config.php, 2: prefix found in the file, 3: prefix used by WordPress.
#: src/class-wp-cli-db-prefix-command.php:768
msgid "%1$s sets the prefix \"%2$s\" but WordPress uses \"%3$s\". Use --skip-config."
msgstr "%1$s définit le préfixe « %2$s » alors que WordPress utilise « %3$s ». Utilisez --skip-config."

#: src/class-wp-cli-db-prefix-command.php:784
msgid "table"
msgstr "table"

#: src/class-wp-cli-db-prefix-command.php:785
msgid "new name"
msgstr "nouveau nom"

#. translators: %d: number of tables.
#: src/class-wp-cli-db-prefix-command.php:798
msgid "Tables to rename: %d"
msgstr "Tables à renommer : %d"

#. translators: %d: number of sites.
#: src/class-wp-cli-db-prefix-command.php:802
msgid "Multisite network: %d sites, user_roles option renamed in each."
msgstr "Réseau multisite : %d sites, option user_roles renommée dans chacun."

#. translators: 1: current option name, 2: new option name.
#: src/class-wp-cli-db-prefix-command.php:805
msgid "Option %1$s renamed to %2$s"
msgstr "Option %1$s renommée en %2$s"

#. translators: %d: number of user meta keys.
#: src/class-wp-cli-db-prefix-command.php:809
msgid "User meta keys to rename: %d"
msgstr "Clés de métadonnées de compte à renommer : %d"

#. translators: %s: path to wp-config.php.
#: src/class-wp-cli-db-prefix-command.php:813
msgid "wp-config.php: %s"
msgstr "wp-config.php : %s"

#: src/class-wp-cli-db-prefix-command.php:815
msgid "wp-config.php: not changed (--skip-config)"
msgstr "wp-config.php : non modifié (--skip-config)"

#. translators: %s: backup folder.
#: src/class-wp-cli-db-prefix-command.php:820
msgid "Backup before renaming (--safe): %s"
msgstr "Sauvegarde avant renommage (--safe) : %s"

#. translators: 1: other prefixes found, 2: number of excluded tables, 3: excluded tables.
#: src/class-wp-cli-db-prefix-command.php:827
msgid "Other installation(s) found in the database (%1$s). These %2$d tables will not be touched: %3$s"
msgstr "Autre(s) installation(s) détectée(s) dans la base de données (%1$s). Ces %2$d tables ne seront pas modifiées : %3$s"

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:851
msgid "Table rename failed, nothing was changed: %s"
msgstr "Échec du renommage des tables, rien n’a été modifié : %s"

#. translators: 1: option name, 2: database error.
#: src/class-wp-cli-db-prefix-command.php:862
msgid "Could not rename option %1$s: %2$s"
msgstr "Impossible de renommer l’option %1$s : %2$s"

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:872
msgid "Could not rename user meta keys: %s"
msgstr "Impossible de renommer les clés de métadonnées de compte : %s"

#. translators: %s: path to wp-config.php.
#: src/class-wp-cli-db-prefix-command.php:883
msgid "Could not write %s."
msgstr "Impossible d’écrire dans %s."

#: src/class-wp-cli-db-prefix-command.php:890
msgid "Rollback failed, restore your backup:"
msgstr "Le retour en arrière a échoué, restaurez votre sauvegarde :"

#: src/class-wp-cli-db-prefix-command.php:893
msgid "All changes were rolled back."
msgstr "Toutes les modifications ont été annulées."

#. translators: 1: current prefix, 2: path to wp-config.php.
#: src/class-wp-cli-db-prefix-command.php:917
msgid "- wp-config.php: set $table_prefix = '%1$s'; back in %2$s"
msgstr "- wp-config.php : remettez $table_prefix = '%1$s'; dans %2$s"

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:924
msgid "- user meta keys: %s"
msgstr "- clés de métadonnées de compte : %s"

#. translators: 1: option name, 2: database error.
#: src/class-wp-cli-db-prefix-command.php:934
msgid "- option %1$s: %2$s"
msgstr "- option %1$s : %2$s"

#. translators: %s: database error.
#: src/class-wp-cli-db-prefix-command.php:941
msgid "- tables: %s"
msgstr "- tables : %s"
